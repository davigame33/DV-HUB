local opened = false
local animating = false

local function openHub()
	if animating or opened then return end
	animating = true
	opened = true
	main.Visible = true
	mainScale.Scale = 0.75

	local animation = TweenService:Create(mainScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
	animation:Play()
	animation.Completed:Connect(function() animating = false end)
end

local function closeHub()
	if animating or not opened then return end
	animating = true
	opened = false

	local animation = TweenService:Create(mainScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0.75})
	animation:Play()
	animation.Completed:Connect(function() main.Visible = false; animating = false end)
end

openButton.MouseButton1Click:Connect(function()
	if opened then closeHub() else openHub() end
end)

openButton.MouseButton1Down:Connect(function()
	TweenService:Create(buttonScale, TweenInfo.new(0.1), {Scale = 0.88}):Play()
end)

openButton.MouseButton1Up:Connect(function()
	TweenService:Create(buttonScale, TweenInfo.new(0.15, Enum.EasingStyle.Back), {Scale = 1}):Play()
end)

