--==================================================
-- LOOP PRINCIPAL (RenderStepped)
--==================================================

RunService.RenderStepped:Connect(function(dt)
	local head = getClosestPlayerHead()

	-- Linha Bot
	if linhaEnabled then
		if head then
			local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
			if onScreen and tracer then
				tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
				tracer.To = Vector2.new(screenPos.X, screenPos.Y)
				tracer.Visible = true
			elseif tracer then
				tracer.Visible = false
			end
			camera.CFrame = CFrame.new(camera.CFrame.Position, head.Position)
		else
			if tracer then tracer.Visible = false end
		end

		local char = player.Character
		if char then
			local tool = char:FindFirstChildOfClass("Tool")
			if tool then
				pcall(function() tool:Activate() end)
			end
		end
	else
		if tracer then tracer.Visible = false end
	end

	-- Holograma RGB
	if hologramEnabled then
		local hue = (tick() % 4) / 4
		local rgbColor = Color3.fromHSV(hue, 1, 1)

		for _, otherPlayer in ipairs(Players:GetPlayers()) do
			if otherPlayer ~= player then
				local isTeamMate = (player.Team and otherPlayer.Team and player.Team == otherPlayer.Team)
				local char = otherPlayer.Character
				
				if not isTeamMate and char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
					local highlight = char:FindFirstChild("DV_HologramHighlight")
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "DV_HologramHighlight"
						highlight.Adornee = char
						highlight.FillTransparency = 0.3
						highlight.OutlineTransparency = 0
						highlight.Parent = char
					end
					highlight.FillColor = rgbColor
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
				else
					if char then
						local highlight = char:FindFirstChild("DV_HologramHighlight")
						if highlight then highlight:Destroy() end
					end
				end
			end
		end
	end

	-- Gira
	if giraEnabled then
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local hrp = char.HumanoidRootPart
			hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(giraSpeed * dt * 10), 0)
		end
	end
end)

